# ============================================================================
# AirSpeak — EAS Environment Variables Template
# ============================================================================
#
# EAS Build cloud'da .env dosyaları YÜKLENMEZ (gitignored). Mobile build'e
# gömülmesi gereken EXPO_PUBLIC_* env'leri EAS Environment Variables üzerinden
# yüklenir.
#
# Yükleme yöntemleri:
#   A) Dashboard: https://expo.dev/accounts/mirissaapss/projects/airspeak/environment-variables
#   B) CLI:
#      eas env:create --environment production \
#        --name EXPO_PUBLIC_SUPABASE_URL --value "https://..." --visibility plaintext
#
# Visibility:
#   - plaintext  → build log'da görünür (URL, public key)
#   - sensitive  → build log'da masked (API key, secret)
#   - secret     → CLI'dan asla okunamaz (production secret)
#
# Environment'lar: development | preview | production (eas.json profile'larıyla
# eşleşir).
#
# ============================================================================
# 1) ZORUNLU — mobile runtime
# ============================================================================

# Supabase backend (visibility: plaintext)
EXPO_PUBLIC_SUPABASE_URL=https://neinhbkdctjtyyoskxpg.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Auth modu — production'da "false" (real Supabase), preview'da "true" (mock)
EXPO_PUBLIC_USE_MOCK_AUTH=false

# ============================================================================
# 2) OPSIYONEL — entegrasyonlar (yoksa graceful fallback çalışır)
# ============================================================================

# RevenueCat (IAP) — visibility: sensitive
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# PostHog (analytics) — visibility: plaintext (host) + sensitive (key)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Sign In — visibility: plaintext
# (Şu an entegre değil, ileride sosyal login eklenirse aktive)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Sentry (crash + performance monitoring)
# DSN — visibility: plaintext (DSN public, runtime'a gömülür)
EXPO_PUBLIC_SENTRY_DSN=https://94266da5377f01a3f6c3158dc9bad3d0@o4511327604703233.ingest.de.sentry.io/4511327611650128

# Source map upload (build-time, mobile bundle'a gömülmez)
# SENTRY_AUTH_TOKEN: visibility=secret — Sentry → Settings → Auth Tokens'tan üret
# scope: project:releases + org:read
SENTRY_AUTH_TOKEN=
SENTRY_ORG=airspeak
SENTRY_PROJECT=react-native

# ============================================================================
# 3) BUILD'E GEREKMEZ — local script'lerde kullanılır, EAS'e yüklenmez
# ============================================================================
# DEEPL_API_KEY            → scripts/i18n/translate-deepl.ts
# GEMINI_API_KEY           → scripts/content/generate.ts
# SUPABASE_PROJECT_ID      → supabase CLI gen-types
# ANTHROPIC_API_KEY        → Edge function secret (Supabase'te set, mobile'a gerekmez)
# OPENAI_API_KEY           → Edge function secret
# ELEVENLABS_API_KEY       → ses üretim script (eğer eklenirse)
