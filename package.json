{
  "name": "airspeak",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "supabase:gen-types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > src/types/database.ts",
    "translate:wikipedia": "tsx --env-file=.env scripts/i18n/translate-wikipedia.ts",
    "translate:deepl": "tsx --env-file=.env scripts/i18n/translate-deepl.ts",
    "translate:argos": "tsx --env-file=.env scripts/i18n/translate-argos.ts",
    "translate:argos:install": "python3 scripts/i18n/install-argos-langs.py",
    "translate:ui": "tsx --env-file=.env scripts/i18n/run-pipeline.ts --target ui-strings",
    "translate:vocab": "tsx --env-file=.env scripts/i18n/run-pipeline.ts --target vocab",
    "translate:placement-long": "tsx --env-file=.env scripts/i18n/run-pipeline.ts --target placement-long",
    "translate:interview-detailed": "tsx --env-file=.env scripts/i18n/run-pipeline.ts --target interview-detailed",
    "translate:vocab-rich": "tsx --env-file=.env scripts/i18n/run-pipeline.ts --target vocab-rich",
    "translate:all": "tsx --env-file=.env scripts/i18n/run-pipeline.ts --target all",
    "translate:check": "tsx --env-file=.env scripts/i18n/quality-check.ts",
    "translate:usage": "tsx --env-file=.env scripts/i18n/translate-deepl.ts --usage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-google-signin/google-signin": "^13.0.0",
    "@sentry/react-native": "^5.30.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tamagui/babel-plugin": "^1.116.0",
    "@tamagui/config": "^1.116.0",
    "@tamagui/lucide-icons": "^1.116.0",
    "@tanstack/react-query": "^5.50.0",
    "date-fns": "^3.6.0",
    "expo": "~52.0.0",
    "expo-application": "~6.0.0",
    "expo-av": "~15.0.0",
    "expo-build-properties": "^55.0.13",
    "expo-constants": "~17.0.0",
    "expo-dev-client": "~5.0.0",
    "expo-device": "~7.0.0",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-localization": "~16.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-speech": "~13.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.0",
    "expo-web-browser": "~14.0.0",
    "i18next": "^23.10.0",
    "lottie-react-native": "~7.0.0",
    "moti": "^0.29.0",
    "openai": "^4.65.0",
    "posthog-react-native": "^3.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.52.0",
    "react-i18next": "^14.0.0",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-google-mobile-ads": "^14.0.0",
    "react-native-mmkv": "^3.0.0",
    "react-native-purchases": "^8.0.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.19.13",
    "tamagui": "^1.116.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~8.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.6.3"
  }
}
