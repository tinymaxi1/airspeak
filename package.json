{
  "name": "airspeak",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "supabase:gen-types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > src/types/database.ts",
    "translate:wikipedia": "tsx --env-file=.env scripts/i18n/translate-wikipedia.ts",
    "translate:deepl": "tsx --env-file=.env scripts/i18n/translate-deepl.ts",
    "translate:argos": "tsx --env-file=.env scripts/i18n/translate-argos.ts",
    "translate:argos:install": "python3 scripts/i18n/install-argos-langs.py",
    "translate:ui": "tsx --env-file=.env scripts/i18n/run-pipeline.ts --target ui-strings",
    "translate:vocab": "tsx --env-file=.env scripts/i18n/run-pipeline.ts --target vocab",
    "translate:placement-long": "tsx --env-file=.env scripts/i18n/run-pipeline.ts --target placement-long",
    "translate:interview-detailed": "tsx --env-file=.env scripts/i18n/run-pipeline.ts --target interview-detailed",
    "translate:vocab-rich": "tsx --env-file=.env scripts/i18n/run-pipeline.ts --target vocab-rich",
    "translate:all": "tsx --env-file=.env scripts/i18n/run-pipeline.ts --target all",
    "translate:check": "tsx --env-file=.env scripts/i18n/quality-check.ts",
    "translate:usage": "tsx --env-file=.env scripts/i18n/translate-deepl.ts --usage",
    "content:placement-long": "tsx --env-file=.env scripts/content/generate.ts placement-long",
    "content:interview-detailed": "tsx --env-file=.env scripts/content/generate.ts interview-detailed",
    "content:vocab-rich": "tsx --env-file=.env scripts/content/generate.ts vocab-rich",
    "content:all": "tsx --env-file=.env scripts/content/generate.ts all",
    "content:inject": "tsx --env-file=.env scripts/content/inject.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^13.0.0",
    "@sentry/react-native": "~6.14.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tamagui/babel-plugin": "^1.116.0",
    "@tamagui/config": "^1.116.0",
    "@tamagui/lucide-icons": "^1.116.0",
    "@tanstack/react-query": "^5.50.0",
    "date-fns": "^3.6.0",
    "expo": "^53.0.0",
    "expo-application": "~6.1.5",
    "expo-audio": "~0.4.9",
    "expo-av": "~15.1.7",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-speech": "~13.1.7",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-tracking-transparency": "~5.2.4",
    "expo-updates": "~0.28.18",
    "expo-web-browser": "~14.2.0",
    "i18next": "^23.10.0",
    "lottie-react-native": "7.2.2",
    "lucide-react-native": "^1.14.0",
    "moti": "^0.29.0",
    "openai": "^4.65.0",
    "posthog-react-native": "^3.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.52.0",
    "react-i18next": "^14.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-google-mobile-ads": "^14.0.0",
    "react-native-mmkv": "^3.0.0",
    "react-native-purchases": "^8.0.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.20.0",
    "tamagui": "^1.116.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3"
  }
}
