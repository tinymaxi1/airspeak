{
  "expo": {
    "name": "AirSpeak",
    "slug": "airspeak",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/logo/app-icon-1024.png",
    "scheme": "airspeak",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1E47"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.airspeak.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AirSpeak telaffuz alıştırmaları ve AI konuşma pratiği için mikrofona ihtiyaç duyar.",
        "NSSpeechRecognitionUsageDescription": "AirSpeak konuşmanı yazıya çevirip ICAO seviye 4 değerlendirmesi yapar.",
        "NSCameraUsageDescription": "Profil avatarın için fotoğraf çekmek istediğinde kamera izni gerekir.",
        "NSPhotoLibraryUsageDescription": "Profil avatarın ve topluluk gönderilerinde fotoğraf seçmen için galeri izni gerekir.",
        "NSPhotoLibraryAddUsageDescription": "Topluluk gönderindeki görselleri galerine kaydetmen için izin gerekir.",
        "NSUserTrackingUsageDescription": "AirSpeak'i ve sana özel reklamları geliştirmek için cihaz tanımlayıcına ihtiyaç duyar. İzin vermesen de uygulama tam çalışır.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.airspeak.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/adaptive-icon.png",
        "backgroundColor": "#0F2D5C"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logo/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "minSdkVersion": 24,
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "AirSpeak telaffuz alıştırmaları için mikrofon erişimine ihtiyaç duyar."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo/notification-icon.png",
          "color": "#2E7CD6"
        }
      ],
      "expo-speech-recognition",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "AirSpeak'i ve sana özel reklamları geliştirmek için cihaz tanımlayıcına ihtiyaç duyar. İzin vermesen de uygulama tam çalışır."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "airspeak",
          "project": "react-native"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "684b9eaf-123f-4145-89a9-89b235aecb46"
      }
    },
    "owner": "mirissaapss",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/684b9eaf-123f-4145-89a9-89b235aecb46"
    }
  }
}
