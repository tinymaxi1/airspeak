{
  "expo": {
    "name": "AirSpeak",
    "slug": "airspeak",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo/app-icon-1024.png",
    "scheme": "airspeak",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2D5C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.airspeak.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AirSpeak telaffuz alıştırmaları ve AI konuşma pratiği için mikrofona ihtiyaç duyar.",
        "NSSpeechRecognitionUsageDescription": "AirSpeak konuşmanı yazıya çevirip ICAO seviye 4 değerlendirmesi yapar.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.airspeak.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/adaptive-icon.png",
        "backgroundColor": "#0F2D5C"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "VIBRATE"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logo/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "AirSpeak telaffuz alıştırmaları için mikrofon erişimine ihtiyaç duyar."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo/notification-icon.png",
          "color": "#2E7CD6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": ""
      }
    },
    "owner": "airspeak"
  }
}
